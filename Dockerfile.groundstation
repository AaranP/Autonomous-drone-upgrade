# Use a ROS Noetic desktop base image, only works for x86, needs emulation for arm
FROM osrf/ros:noetic-desktop-full

# Set up environment variables
ENV HOME=/root
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /root/catkin_ws/src

# Install common ground station dependencies, including Ceres Solver and its common dependencies
# Many are already in desktop-full, but explicitly listing ensures they are present
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    terminator \
    net-tools \
    ros-noetic-plotjuggler \
    ros-noetic-plotjuggler-ros \
    # Dependencies for Ceres Solver and related libraries (as seen in main Dockerfile)
    libgoogle-glog-dev \
    libgflags-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libsuitesparse-dev \
    liblapack-dev \
    libceres-dev \
    libyaml-cpp-dev \
    libomp-dev \
    # Additional common ROS dependencies that might be needed for VINS-Fusion or other packages
    ros-noetic-pcl-ros \
    ros-noetic-ddynamic-reconfigure \
    ros-noetic-mavros \
    # Add any other specific ground station tools if needed, e.g., ros-noetic-rqt*
    && rm -rf /var/lib/apt/lists/*

# --- Install Realsense SDK dependencies (as per official guide) ---
# Add Intel's public key
RUN apt-key adv --keyserver keys.gnupg.net --recv-key F6E65AC044F831AC80A06380C8B3A55A6F3EFCDE || \
    apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-key F6E65AC044F831AC80A06380C8B3A55A6F3EFCDE

# Add Intel's apt repository
RUN sh -c 'echo "deb https://librealsense.intel.com/Debian/apt-repo `lsb_release -cs` main" > /etc/apt/sources.list.d/realsense-apt-source.list'

# Install Realsense SDK and ROS wrappers
RUN apt-get update && apt-get install -y --no-install-recommends \
    librealsense2-dkms \
    librealsense2-utils \
    librealsense2-dev \
    librealsense2-dbg \
    ros-noetic-realsense2-camera \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-util1 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    qtbase5-dev \
    tigervnc-standalone-server \
    xfonts-base \
    # VNC server and fonts for better compatibility
    && rm -rf /var/lib/apt/lists/*
# --- End Realsense SDK installation ---

# Install GeographicLib datasets for MAVROS (now that mavros is installed above)
RUN /opt/ros/noetic/lib/mavros/install_geographiclib_datasets.sh

# Copy your client.sh script and any other necessary ground station files
# Assuming your ground station might also need some of the project's ROS packages
# for Rviz configurations or specific client nodes.
# If not, you can remove the 'COPY .' and 'catkin_make' lines.
# --- CORRECTED ---
# Copy only the 'src' directory from your project into the workspace 'src' folder
COPY src/ /root/catkin_ws/src/

# Copy the shfiles directory and make its contents executable
COPY shfiles/ /root/shfiles/
RUN chmod +x /root/shfiles/*.sh

# Build the entire catkin workspace (if ground station needs to run custom nodes)
WORKDIR /root/catkin_ws
RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make"

# Configure environment for ROS (for interactive sessions)
RUN echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc
RUN echo "source /root/catkin_ws/devel/setup.bash" >> ~/.bashrc

# Create VNC startup script
RUN mkdir -p /root/.vnc && \
    echo '#!/bin/bash' > /root/start_vnc.sh && \
    echo 'echo "Starting VNC server on :1 (port 5901)..."' >> /root/start_vnc.sh && \
    echo 'vncserver :1 -geometry 1920x1080 -depth 24' >> /root/start_vnc.sh && \
    echo 'echo "VNC server started. Connect with: 127.0.0.1:5901"' >> /root/start_vnc.sh && \
    echo 'source /opt/ros/noetic/setup.bash' >> /root/start_vnc.sh && \
    echo 'source /root/catkin_ws/devel/setup.bash' >> /root/start_vnc.sh && \
    echo '/bin/bash' >> /root/start_vnc.sh && \
    chmod +x /root/start_vnc.sh

# Expose VNC port
EXPOSE 5901

# Set default command to bash for interactive use
CMD ["/bin/bash"]