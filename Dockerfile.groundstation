FROM arm64v8/ubuntu:20.04

# Set up environment variables
ENV HOME=/root
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /root/catkin_ws/src

# Setup ROS Noetic manually (since osrf/ros:noetic-desktop-full is x86-only)
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release && \
    sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list' && \
    curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -

# Install ROS Noetic Desktop Full and your specific dependencies
RUN apt-get update && apt-get install -y \
    ros-noetic-desktop-full \
    python3-rosdep \
    python3-rosinstall \
    python3-rosinstall-generator \
    python3-wstool \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    terminator \
    net-tools \
    ros-noetic-plotjuggler \
    ros-noetic-plotjuggler-ros \
    xterm \
    # Dependencies for Ceres Solver and related libraries (as seen in main Dockerfile)
    libgoogle-glog-dev \
    libgflags-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libsuitesparse-dev \
    liblapack-dev \
    libceres-dev \
    libyaml-cpp-dev \
    libomp-dev \
    # Additional common ROS dependencies that might be needed for VINS-Fusion or other packages
    ros-noetic-pcl-ros \
    ros-noetic-ddynamic-reconfigure \
    ros-noetic-mavros \
    # Add any other specific ground station tools if needed, e.g., ros-noetic-rqt*
    # OpenGL/X11 dependencies for GUI applications like Rviz, rqt_image_view
    mesa-utils \
    libgl1-mesa-glx \
    mesa-common-dev \
    libglu1-mesa \
    libglu1-mesa-dev \
    libosmesa6 \
    libglapi-mesa \
    libglx-mesa0 \
    libglvnd-dev \
    libgl1-mesa-dri \
    # VNC server and fonts for better compatibility on macOS and general GUI forwarding
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    qtbase5-dev \
    tigervnc-standalone-server \
    xfonts-base \
    tigervnc-common \
    # Ensure correct Qt platform themes are available for some GUI applications
    qt5-gtk2-platformtheme \
    && rm -rf /var/lib/apt/lists/*


# Install Realsense SDK from source for ARM64, as pre-built binaries are not available.
# First, install build dependencies for librealsense.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0-dev \
    libssl-dev \
    pkg-config \
    libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone, build, and install librealsense from scratch since existing one doesn't support ARM natively.
# This is done in a single RUN command to keep the Docker image layers minimal.
# We build with the RSUSB backend, which doesn't require kernel patching (DKMS), making it ideal for ARM devices.
ENV REALSENSE_VERSION=2.50.0
RUN cd /root && \
    git clone --depth 1 --branch v${REALSENSE_VERSION} https://github.com/IntelRealSense/librealsense.git && \
    cd librealsense && \
    mkdir build && cd build && \
    cmake ../ -DBUILD_EXAMPLES=false \
              -DBUILD_GRAPHICAL_EXAMPLES=false \
              -DCMAKE_BUILD_TYPE=Release \
              -DFORCE_RSUSB_BACKEND=ON && \
    make -j$(nproc) && \
    make install && \
    cd /root && \
    rm -rf /root/librealsense

# Install GeographicLib datasets for MAVROS (now that mavros is installed above)
RUN /opt/ros/noetic/lib/mavros/install_geographiclib_datasets.sh

# Copy your client.sh script and any other necessary ground station files
# Assuming your ground station might also need some of the project's ROS packages
# for Rviz configurations or specific client nodes.
# If not, you can remove the 'COPY .' and 'catkin_make' lines.
# --- CORRECTED ---
# Copy only the 'src' directory from your project into the workspace 'src' folder
COPY src/ /root/catkin_ws/src/

# Copy the shfiles directory and make its contents executable
COPY shfiles/ /root/shfiles/
RUN chmod +x /root/shfiles/*.sh

# Build the entire catkin workspace (if ground station needs to run custom nodes)
WORKDIR /root/catkin_ws
RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make"

# Configure environment for ROS (for interactive sessions)
RUN echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc
RUN echo "source /root/catkin_ws/devel/setup.bash" >> ~/.bashrc

# Create VNC startup script kinda optional
RUN mkdir -p /root/.vnc && \
    echo '#!/bin/bash' > /root/.vnc/xstartup && \
    echo 'unset SESSION_MANAGER' >> /root/.vnc/xstartup && \
    echo 'unset DBUS_SESSION_BUS_ADDRESS' >> /root/.vnc/xstartup && \
    echo 'startxfce4 &' >> /root/.vnc/xstartup && \
    chmod +x /root/.vnc/xstartup

# Add the actual start_vnc.sh script with improved hostname handling
RUN echo '#!/bin/bash' > /root/start_vnc.sh && \
    echo 'export USER=root' >> /root/start_vnc.sh && \
    echo 'export PATH=$PATH:/usr/bin' >> /root/start_vnc.sh && \
    echo 'if ! pgrep Xtigervnc > /dev/null; then' >> /root/start_vnc.sh && \
    echo '  # Set a VNC password if not already set' >> /root/start_vnc.sh && \
    echo '  if [ ! -f ~/.vnc/passwd ]; then' >> /root/start_vnc.sh && \
    echo '    echo "You will need to set a VNC password the first time you run this script." ' >> /root/start_vnc.sh && \
    echo '    vncpasswd' >> /root/start_vnc.sh && \
    echo '  fi' >> /root/start_vnc.sh && \
    echo '  echo "Starting VNC server on :1 (port 5901)..."' >> /root/start_vnc.sh && \
    echo '  vncserver :1 -geometry 1280x800 -depth 24 -localhost no -rfbport 5901' >> /root/start_vnc.sh && \
    echo 'else' >> /root/start_vnc.sh && \
    echo '  echo "VNC server already running." ' >> /root/start_vnc.sh && \
    echo 'fi' >> /root/start_vnc.sh && \
    echo 'echo "Connect with: 127.0.0.1:5901"' >> /root/start_vnc.sh && \
    chmod +x /root/start_vnc.sh

# Expose VNC port
EXPOSE 5901

# Set default command to bash for interactive use
CMD ["/bin/bash"]