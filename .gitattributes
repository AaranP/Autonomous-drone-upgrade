# Set the default behavior for all text files to be handled automatically.
# This prevents Git from guessing and makes the rules below explicit.
* text=auto

# Explicitly force Linux (LF) line endings for scripts and config files.
# This is critical for shell scripts to be executable on Linux.
*.sh    text eol=lf
*.py    text eol=lf
*.launch text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf